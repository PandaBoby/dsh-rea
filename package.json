{
  "name": "@panda-boby/dsh-rea",
  "version": "0.2.0",
  "description": "Mounts the REA (Reverse Engineer Anything) MCP server as the `rea` tool namespace in every session, with one switch in the Plugins page. Ships no engine and no tool code of its own: it only declares the connection, and the newest rea-agents release is fetched by npx when the switch is on.",
  "icon": "icon.svg",
  "type": "module",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/assets/*"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mcp",
    "rea",
    "reverse-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PandaBoby/dsh-rea.git"
  },
  "homepage": "https://github.com/PandaBoby/dsh-rea#readme",
  "bugs": {
    "url": "https://github.com/PandaBoby/dsh-rea/issues"
  },
  "author": "PandaBoby (https://github.com/PandaBoby)",
  "license": "MIT",
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
